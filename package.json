{
  "name": "glb",
  "version": "1.0.0",
  "description": "Civic telemetry aggregator and geospatial API for Macedonia",
  "homepage": "https://github.com/nkvtd/glb#readme",
  "bugs": {
    "url": "https://github.com/nkvtd/glb/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nkvtd/glb.git"
  },
  "license": "Apache-2.0",
  "author": "nkvtd",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "@hono/zod-validator": "^0.9.0",
    "croner": "^10.0.1",
    "dotenv": "^18.0.4",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.4",
    "drizzle-zod": "^0.8.3",
    "hono": "^4.13.13",
    "hono-rate-limiter": "^0.5.3",
    "pg": "^8.23.1",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^4.4.3",
    "zod-validation-error": "^5.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.21.0",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.11",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "esbuild": "^0.25.0"
  },
  "scripts": {
    "build": "rimraf dist && node esbuild.config.js",
    "lint": "biome check src",
    "lint:fix": "biome check --write src",
    "format": "biome format --write src",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "node dist/infrastructure/database/seed.js",
    "start:server": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "dev:server": "tsx src/server.ts",
    "dev:worker": "tsx src/worker.ts"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
