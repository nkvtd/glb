# Optional. Server port if default port 8080 is not available.
PORT=YOUR_PORT_HERE

# Postgres in production. Used by docker-compose.yml to build the database URL.
POSTGRES_USER=YOUR_POSTGRES_USER_HERE
POSTGRES_DB=YOUR_POSTGRES_DB_HERE

# Required for local development.
# In Docker, docker-compose.yml builds this from POSTGRES_USER,
# POSTGRES_DB, and the database password secret.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB

# Optional. Discord webhook used to alert on ongoing reports.
# Omit to disable alerting.
DISCORD_WEBHOOK_URL=YOUR_DISCORD_WEBHOOK_URL_HERE